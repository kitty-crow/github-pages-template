{
  "name": "@kitty-crow/github-pages-template",
  "version": "0.2.3",
  "description": "Unbranded GitHub Pages build, runtime and component foundation.",
  "type": "module",
  "license": "MIT",
  "author": "Kitty Crow <kitty@kittycrow.dev> (https://kittycrow.dev)",
  "repository": "github:kitty-crow/github-pages-template",
  "bin": {
    "pages-template": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/run/index.ts"
  },
  "files": [
    "src",
    "web",
    "scaffold",
    "docs",
    "README.md",
    "LICENSE",
    "version.json"
  ],
  "scripts": {
    "check": "bunx tsc --noEmit && bun test",
    "test": "bun test",
    "example:build": "bun src/cli.ts build example/pages.config.ts",
    "example:serve": "bun src/serve.ts example/site"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "keywords": [
    "github-pages",
    "static-site",
    "bun",
    "typescript",
    "submodule"
  ]
}
